<Window x:Class="AutomatedClashRunner.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Automated Clash Runner and Distiller" 
        Height="740" Width="1140" 
        MinHeight="600" MinWidth="920"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" 
        FontSize="12"
        Background="#F8FAFC">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Modern SearchBox Style -->
        <Style x:Key="ModernSearchBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="2" />
                            </Border>
                            <TextBlock Text="{TemplateBinding Tag}"
                                       Foreground="#94A3B8"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="BorderBrush" Value="#94A3B8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Solid Green Button Style -->
        <Style x:Key="PrimaryGreenButton" TargetType="Button">
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Background" Value="#00875A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#00704A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00A36C"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#94A3B8"/>
                    <Setter Property="Opacity" Value="0.6"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Mini Selection Button -->
        <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>

        <!-- Status Filter Toggle Button -->
        <Style x:Key="StatusToggleButton" TargetType="ToggleButton">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#0284C7"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#0369A1"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#0284C7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Clean GridView Header Style -->
        <Style x:Key="CleanGridViewHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Modern TabItem Style -->
        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,3"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,12,0"
                                Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#00875A"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP APP HEADER BAR -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,12,16,12">
            <DockPanel>
                <Border Width="34" Height="34" Background="#00875A" CornerRadius="6" Margin="0,0,12,0" DockPanel.Dock="Left">
                    <TextBlock Text="ACR" FontWeight="Bold" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Automated Clash Runner &amp; Distiller" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
                    <TextBlock Text="Autodesk Navisworks Automated Coordination Suite" FontSize="11" Foreground="#64748B"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN TABS CONTAINER -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="14,10,14,14">
            
            <!-- ========================================================================= -->
            <!-- TAB 1: GENERATE MATRIX                                                    -->
            <!-- ========================================================================= -->
            <TabItem Header="Generate Matrix" Style="{StaticResource ModernTabItem}" DataContext="{Binding MatrixTab}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Models / NWCs -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="0,0,6,8" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="Selected Models / NWCs" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ModelSelectionSummary}" HorizontalAlignment="Right" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                            </DockPanel>

                            <DockPanel Grid.Row="1" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="4,0,0,0">
                                    <Button Content="All" Command="{Binding SelectAllModelsCommand}" Style="{StaticResource MiniButton}"/>
                                    <Button Content="None" Command="{Binding DeselectAllModelsCommand}" Style="{StaticResource MiniButton}"/>
                                </StackPanel>
                                <TextBox Style="{StaticResource ModernSearchBox}" 
                                         Tag="Filter models by name..." 
                                         Text="{Binding SearchTextModels, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>

                            <ListView Grid.Row="2" ItemsSource="{Binding ModelsView}" BorderBrush="#E2E8F0" Background="#FFFFFF">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsSelectable}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border Background="#F1F5F9" CornerRadius="3" Padding="5,1" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding DisplayType}" FontSize="10" Foreground="#475569" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" Foreground="#0F172A" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding WarningMessage}" Foreground="#DC2626" Margin="8,0,0,0" FontStyle="Italic" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock Grid.Row="2" Text="No NWC models found in document." 
                                       Foreground="#94A3B8" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasNoModels, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>

                    <!-- Right: Search Sets -->
                    <Border Grid.Row="0" Grid.Column="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="6,0,0,8" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="Manual Search Sets" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SetSelectionSummary}" HorizontalAlignment="Right" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                            </DockPanel>

                            <DockPanel Grid.Row="1" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="4,0,0,0">
                                    <Button Content="All" Command="{Binding SelectAllSetsCommand}" Style="{StaticResource MiniButton}"/>
                                    <Button Content="None" Command="{Binding DeselectAllSetsCommand}" Style="{StaticResource MiniButton}"/>
                                </StackPanel>
                                <TextBox Style="{StaticResource ModernSearchBox}" 
                                         Tag="Filter search sets by path..." 
                                         Text="{Binding SearchTextSets, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>

                            <ListView Grid.Row="2" ItemsSource="{Binding SearchSetsView}" BorderBrush="#E2E8F0" Background="#FFFFFF">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="True" VerticalAlignment="Center" Margin="0,0,8,0"
                                                      Visibility="{Binding IsSet, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding FullPath}" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock Grid.Row="2" Text="No manual search sets found in document." 
                                       Foreground="#94A3B8" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasNoSets, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>

                    <!-- Bottom Configuration Card -->
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="Clash Test Type: " VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                            <ComboBox ItemsSource="{Binding AvailableClashTypes}" SelectedItem="{Binding SelectedClashType}" Width="130" Margin="0,0,20,0" Padding="6,3"/>
                            
                            <TextBlock Text="Tolerance (m): " VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBox Text="{Binding Tolerance, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,20,0" Padding="6,3" VerticalContentAlignment="Center"/>

                            <TextBlock Text="Selection B Mode: " VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBlock Text="Standard Model Hierarchy | " VerticalAlignment="Center" Foreground="#00875A" FontWeight="SemiBold" Margin="0,0,8,0"/>

                            <TextBlock Text="Composite Clashing: " VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBlock Text="Enabled" VerticalAlignment="Center" Foreground="#64748B"/>
                        </WrapPanel>
                    </Border>

                    <!-- Footer Action Bar -->
                    <DockPanel Grid.Row="2" Grid.ColumnSpan="2">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Content="Refresh Models" Command="{Binding RefreshModelsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                            <Button Content="Refresh Sets" Command="{Binding RefreshSearchSetsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                            <Button Content="Clear All" Command="{Binding ClearAllCommand}" Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                            <Button Content="{Binding ExpectedTestCount, StringFormat='Run Clash Matrix ({0} Tests)'}" 
                                    Command="{Binding RunCommand}" 
                                    Style="{StaticResource PrimaryGreenButton}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Loading / Busy Overlay -->
                    <Grid Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#90FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <Border Background="#FFFFFF" BorderBrush="#00875A" BorderThickness="2" CornerRadius="8" 
                                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" Width="440">
                            <StackPanel>
                                <TextBlock Text="Executing Clash Matrix..." FontWeight="Bold" FontSize="15" Foreground="#00875A" Margin="0,0,0,12" HorizontalAlignment="Center"/>
                                <ProgressBar Value="{Binding ProgressBarValue}" Maximum="{Binding ProgressBarMax}" Height="18" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding ProgressText}" Foreground="#475569" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>


            <!-- ========================================================================= -->
            <!-- TAB 2: DISTILL (MATCHING REFERENCE IMAGE 2)                               -->
            <!-- ========================================================================= -->
            <TabItem Header="Distill Clashes" Style="{StaticResource ModernTabItem}" DataContext="{Binding DistillerTab}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title Header Banner (Matching Reference 2) -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="DISTILL" FontWeight="Bold" FontSize="26" Foreground="#0F172A" VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Select All" Command="{Binding SelectAllTestsCommand}" Style="{StaticResource MiniButton}" Margin="0,0,4,0"/>
                            <Button Content="Deselect All" Command="{Binding DeselectAllTestsCommand}" Style="{StaticResource MiniButton}" Margin="0,0,8,0"/>
                            <TextBox Style="{StaticResource ModernSearchBox}" 
                                     Tag="Filter tests..." 
                                     Width="220"
                                     Text="{Binding SearchTextTests, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Main Data Table with Column Counts (Matching Reference 2 Table) -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10">
                        <ListView ItemsSource="{Binding TestsView}" BorderThickness="0" Background="Transparent">
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource CleanGridViewHeader}">
                                    <GridViewColumn Width="40">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Clash Test" Width="430">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                                                    <TextBlock Text="âœ“" Foreground="#00875A" FontWeight="Bold" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Active/New" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ActiveNewCount}" Foreground="#D97706" FontWeight="SemiBold" TextAlignment="Right"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Reviewed" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ReviewedCount}" Foreground="#0284C7" FontWeight="SemiBold" TextAlignment="Right"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Approved" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ApprovedCount}" Foreground="#00875A" FontWeight="SemiBold" TextAlignment="Right"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Resolved" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ResolvedCount}" Foreground="#64748B" TextAlignment="Right"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Total" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TotalCount}" FontWeight="Bold" Foreground="#0F172A" TextAlignment="Right"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>

                    <!-- Distillation Settings Card (Matching Reference 2 Card) -->
                    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="420"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Distillation Proximity & Group Settings -->
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Distillation Settings" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,8"/>
                                
                                <!-- Focused <--> Global Slider -->
                                <TextBlock Text="Proximity Clustering Range:" FontWeight="SemiBold" Foreground="#475569" FontSize="11" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="Focused" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                    <TextBlock Text="Global" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                                    <TextBox Text="{Binding GroupingProximity, UpdateSourceTrigger=PropertyChanged}" Width="40" DockPanel.Dock="Right" Padding="2" TextAlignment="Center" VerticalContentAlignment="Center" Margin="6,0,0,0"/>
                                    <Slider Minimum="1" Maximum="150" Value="{Binding GroupingProximity}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBlock Text="Clustering Strategy:" FontWeight="SemiBold" Foreground="#475569" FontSize="11" Margin="0,0,0,4"/>
                                <TextBlock Text="â€¢ Group by Master Named Element in Selection A" Foreground="#0F172A" FontSize="11" Margin="4,0,0,2"/>
                                <TextBlock Text="â€¢ Sub-cluster by spatial proximity threshold" Foreground="#0F172A" FontSize="11" Margin="4,0,0,0"/>
                            </StackPanel>

                            <!-- Right: Status / Priority Settings -->
                            <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Clash Classification &amp; Grouping" FontWeight="Bold" FontSize="12" Foreground="#0F172A" Margin="0,0,0,8"/>
                                    <TextBlock Text="Group naming format: {TestName}-{001, 002, ...}" FontSize="11" Foreground="#475569" Margin="0,0,0,6"/>
                                    <TextBlock Text="Raw clashes within proximity distance are organized cleanly into named groups under each clash test in Clash Detective." FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Bottom Action Bar (Matching Reference 2 Buttons!) -->
                    <DockPanel Grid.Row="3">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Content="Refresh Tests" Command="{Binding RefreshTestsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                            <Button Content="Re-Run Selected" Command="{Binding ReRunSelectedCommand}" Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Distill Selected Test(s)" Command="{Binding DistillSelectedCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                            <Button Content="Distill All Tests" Command="{Binding DistillAllCommand}" Style="{StaticResource PrimaryGreenButton}"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>


            <!-- ========================================================================= -->
            <!-- TAB 3: VIEWPOINTS (MATCHING REFERENCE IMAGE 1)                           -->
            <!-- ========================================================================= -->
            <TabItem Header="Create Viewpoints" Style="{StaticResource ModernTabItem}" DataContext="{Binding ViewpointsTab}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title Header Banner (Matching Reference 1) -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="VIEWPOINTS" FontWeight="Bold" FontSize="26" Foreground="#0F172A" VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Select All" Command="{Binding SelectAllTestsCommand}" Style="{StaticResource MiniButton}" Margin="0,0,4,0"/>
                            <Button Content="Deselect All" Command="{Binding DeselectAllTestsCommand}" Style="{StaticResource MiniButton}" Margin="0,0,8,0"/>
                            <TextBox Style="{StaticResource ModernSearchBox}" 
                                     Tag="Filter tests..." 
                                     Width="220"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Main Data Table (Matching Reference 1 Table) -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10">
                        <ListView ItemsSource="{Binding TestsView}" BorderThickness="0" Background="Transparent">
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource CleanGridViewHeader}">
                                    <GridViewColumn Width="40">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Clash Test" Width="440">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Active/New" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ActiveNewCount}" Foreground="#D97706" FontWeight="SemiBold" TextAlignment="Right"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Reviewed" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ReviewedCount}" Foreground="#0284C7" FontWeight="SemiBold" TextAlignment="Right"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Approved" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ApprovedCount}" Foreground="#00875A" FontWeight="SemiBold" TextAlignment="Right"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Resolved" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ResolvedCount}" Foreground="#64748B" TextAlignment="Right"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Total" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TotalCount}" FontWeight="Bold" Foreground="#0F172A" TextAlignment="Right"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>

                    <!-- Viewpoint Settings Card (Matching Reference 1 Card) -->
                    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Viewpoint Settings" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,8"/>

                            <WrapPanel Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" Margin="0,0,24,6">
                                    <TextBlock Text="Group by: " FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="8,4">
                                        <TextBlock Text="Dedicated Test Folder" FontWeight="Medium" Foreground="#0F172A"/>
                                    </Border>
                                </StackPanel>

                                <CheckBox Content="Place viewpoints in timestamped master folder" IsChecked="{Binding PlaceInTimestampedFolder}" VerticalAlignment="Center" Margin="0,0,20,6"/>
                            </WrapPanel>

                            <!-- Status Filter Toggle Buttons (Matching Reference 1 Include statuses) -->
                            <DockPanel>
                                <TextBlock Text="Include statuses: " FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton Content="New" IsChecked="{Binding IncludeNew}" Style="{StaticResource StatusToggleButton}" Margin="0,0,4,0"/>
                                    <ToggleButton Content="Active" IsChecked="{Binding IncludeActive}" Style="{StaticResource StatusToggleButton}" Margin="0,0,4,0"/>
                                    <ToggleButton Content="Reviewed" IsChecked="{Binding IncludeReviewed}" Style="{StaticResource StatusToggleButton}" Margin="0,0,4,0"/>
                                    <ToggleButton Content="Approved" IsChecked="{Binding IncludeApproved}" Style="{StaticResource StatusToggleButton}" Margin="0,0,4,0"/>
                                    <ToggleButton Content="Resolved" IsChecked="{Binding IncludeResolved}" Style="{StaticResource StatusToggleButton}"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Bottom Action Bar (Matching Reference 1 Buttons!) -->
                    <DockPanel Grid.Row="3">
                        <Button Content="Refresh Tests" Command="{Binding RefreshTestsCommand}" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Left"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Create Viewpoints for Selected Test(s)" Command="{Binding CreateViewpointsSelectedCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                            <Button Content="Create Viewpoints for All Tests" Command="{Binding CreateViewpointsAllCommand}" Style="{StaticResource PrimaryGreenButton}"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
