<Window x:Class="AutomatedClashRunner.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Automated Model Clash Runner &amp; Distiller" Height="680" Width="1050" 
        MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Watermark Style for TextBoxes -->
        <Style x:Key="WatermarkTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#CFD8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="2" />
                            </Border>
                            <TextBlock Text="{TemplateBinding Tag}"
                                       Foreground="#90A4AE"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Button Style -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="#ECEFF1"/>
            <Setter Property="Foreground" Value="#263238"/>
            <Setter Property="BorderBrush" Value="#CFD8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CFD8DC"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Accent Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="#0288D1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0277BD"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#039BE5"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#B0BEC5"/>
                    <Setter Property="Foreground" Value="#ECEFF1"/>
                    <Setter Property="Opacity" Value="0.7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Action / Tool Button Style -->
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="#37474F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#263238"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#455A64"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Mini Selection Button Style -->
        <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F7F8">
        <TabControl Margin="10" Background="White" BorderBrush="#E0E0E0">
            
            <!-- ========================================================= -->
            <!-- TAB 1: GENERATE CLASH MATRIX                             -->
            <!-- ========================================================= -->
            <TabItem Header="Generate Matrix" DataContext="{Binding MatrixTab}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT PANEL: Models -->
                    <GroupBox Grid.Row="0" Grid.Column="0" Margin="0,0,6,6" BorderBrush="#B0BEC5">
                        <GroupBox.Header>
                            <DockPanel>
                                <TextBlock Text="Selected Models / NWCs" FontWeight="Bold" Foreground="#37474F"/>
                                <TextBlock Text="{Binding ModelSelectionSummary}" HorizontalAlignment="Right" Foreground="#78909C" FontSize="11" Margin="10,0,0,0"/>
                            </DockPanel>
                        </GroupBox.Header>
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Search & Quick Selection Toolbar -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="4,0,0,0">
                                    <Button Content="☑ All" Command="{Binding SelectAllModelsCommand}" Style="{StaticResource MiniButton}"/>
                                    <Button Content="☐ None" Command="{Binding DeselectAllModelsCommand}" Style="{StaticResource MiniButton}"/>
                                </StackPanel>
                                <TextBox Style="{StaticResource WatermarkTextBox}" 
                                         Tag="🔍 Filter models by name..." 
                                         Text="{Binding SearchTextModels, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>

                            <!-- Models List -->
                            <ListView Grid.Row="1" ItemsSource="{Binding ModelsView}" BorderBrush="#CFD8DC" Background="White">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsSelectable}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <Border Background="#ECEFF1" CornerRadius="2" Padding="4,1" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding DisplayType}" FontSize="10" Foreground="#546E7A"/>
                                            </Border>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" Foreground="#263238" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding WarningMessage}" Foreground="#D32F2F" Margin="6,0,0,0" FontStyle="Italic" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Empty State -->
                            <TextBlock Grid.Row="1" Text="No NWC models found. Please open an NWF/NWD file with appended models." 
                                       Foreground="#90A4AE" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="20"
                                       Visibility="{Binding HasNoModels, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </GroupBox>

                    <!-- RIGHT PANEL: Search Sets -->
                    <GroupBox Grid.Row="0" Grid.Column="1" Margin="6,0,0,6" BorderBrush="#B0BEC5">
                        <GroupBox.Header>
                            <DockPanel>
                                <TextBlock Text="Manual Search Sets" FontWeight="Bold" Foreground="#37474F"/>
                                <TextBlock Text="{Binding SetSelectionSummary}" HorizontalAlignment="Right" Foreground="#78909C" FontSize="11" Margin="10,0,0,0"/>
                            </DockPanel>
                        </GroupBox.Header>
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Search & Quick Selection Toolbar -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="4,0,0,0">
                                    <Button Content="☑ All" Command="{Binding SelectAllSetsCommand}" Style="{StaticResource MiniButton}"/>
                                    <Button Content="☐ None" Command="{Binding DeselectAllSetsCommand}" Style="{StaticResource MiniButton}"/>
                                </StackPanel>
                                <TextBox Style="{StaticResource WatermarkTextBox}" 
                                         Tag="🔍 Filter search sets by path..." 
                                         Text="{Binding SearchTextSets, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>

                            <!-- Search Sets List -->
                            <ListView Grid.Row="1" ItemsSource="{Binding SearchSetsView}" BorderBrush="#CFD8DC" Background="White">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="True" VerticalAlignment="Center" Margin="0,0,6,0"
                                                      Visibility="{Binding IsSet, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding FullPath}" Foreground="#263238" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Empty State -->
                            <TextBlock Grid.Row="1" Text="No manual search sets found. Create search sets in Navisworks first." 
                                       Foreground="#90A4AE" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="20"
                                       Visibility="{Binding HasNoSets, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </GroupBox>

                    <!-- BOTTOM PANEL: Configurable Clash Settings -->
                    <GroupBox Header="Clash Test Configuration" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,6" BorderBrush="#CFD8DC">
                        <WrapPanel Margin="8,4" VerticalAlignment="Center">
                            <TextBlock Text="Clash Type: " VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#37474F"/>
                            <ComboBox ItemsSource="{Binding AvailableClashTypes}" SelectedItem="{Binding SelectedClashType}" Width="120" Margin="0,0,16,0" Padding="4,2"/>
                            
                            <TextBlock Text="Tolerance (m): " VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#37474F"/>
                            <TextBox Text="{Binding Tolerance, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,16,0" Padding="4,2" VerticalContentAlignment="Center"/>

                            <TextBlock Text="Composite Objects: " VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#37474F"/>
                            <TextBlock Text="Enabled | " VerticalAlignment="Center" Foreground="#546E7A" Margin="0,0,8,0"/>

                            <TextBlock Text="Rules: " VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#37474F"/>
                            <TextBlock Text="Default" VerticalAlignment="Center" Foreground="#546E7A"/>
                        </WrapPanel>
                    </GroupBox>

                    <!-- FOOTER ACTIONS -->
                    <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Content="Refresh Models" Command="{Binding RefreshModelsCommand}" Style="{StaticResource FlatButton}" Margin="0,0,6,0"/>
                            <Button Content="Refresh Sets" Command="{Binding RefreshSearchSetsCommand}" Style="{StaticResource FlatButton}" Margin="0,0,6,0"/>
                            <Button Content="Clear All" Command="{Binding ClearAllCommand}" Style="{StaticResource FlatButton}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    Style="{StaticResource FlatButton}" Margin="0,0,8,0"/>
                            <Button Content="{Binding ExpectedTestCount, StringFormat='Run Clash Tests ({0})'}" 
                                    Command="{Binding RunCommand}" 
                                    Style="{StaticResource PrimaryButton}" 
                                    Padding="16,8"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- BUSY / PROGRESS OVERLAY -->
                    <Grid Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#80FFFFFF" 
                          Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <Border Background="White" BorderBrush="#0288D1" BorderThickness="2" CornerRadius="6" 
                                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Width="400">
                            <StackPanel>
                                <TextBlock Text="Executing Clash Matrix..." FontWeight="Bold" FontSize="14" Foreground="#0288D1" Margin="0,0,0,12" HorizontalAlignment="Center"/>
                                <ProgressBar Value="{Binding ProgressBarValue}" Maximum="{Binding ProgressBarMax}" Height="18" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding ProgressText}" Foreground="#546E7A" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ========================================================= -->
            <!-- TAB 2: DISTILLER & MANAGE TESTS                          -->
            <!-- ========================================================= -->
            <TabItem Header="Distiller / Manage Tests" DataContext="{Binding DistillerTab}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Search & Selection Toolbar -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                            <Button Content="☑ Select All" Command="{Binding SelectAllTestsCommand}" Style="{StaticResource MiniButton}" Padding="8,4"/>
                            <Button Content="☐ Deselect All" Command="{Binding DeselectAllTestsCommand}" Style="{StaticResource MiniButton}" Padding="8,4"/>
                            <TextBlock Text="{Binding TestSelectionSummary}" Foreground="#78909C" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"/>
                        </StackPanel>
                        <TextBox Style="{StaticResource WatermarkTextBox}" 
                                 Tag="🔍 Filter clash tests by name..." 
                                 Text="{Binding SearchTextTests, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    
                    <!-- Clash Tests List -->
                    <ListView Grid.Row="1" ItemsSource="{Binding TestsView}" BorderBrush="#CFD8DC" Background="White">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="#263238" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <Border Background="#ECEFF1" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#455A64" FontStyle="Italic"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty State -->
                    <TextBlock Grid.Row="1" Text="No clash tests found in Clash Detective. Run a matrix or create tests first." 
                               Foreground="#90A4AE" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="20"
                               Visibility="{Binding HasNoTests, Converter={StaticResource BoolToVis}}"/>

                    <!-- Bottom Controls & Action Bar -->
                    <DockPanel Grid.Row="2" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="Max Group Proximity (ft): " FontWeight="SemiBold" Foreground="#37474F" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding GroupingProximity, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="0,0,6,0" Padding="3,2" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            <Slider Minimum="0" Maximum="150" Value="{Binding GroupingProximity}" Width="140" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Refresh Tests" Command="{Binding RefreshTestsCommand}" Style="{StaticResource FlatButton}" Margin="0,0,6,0"/>
                            <Button Content="Group by Element" Command="{Binding GroupByElementCommand}" Style="{StaticResource ActionButton}" Margin="0,0,6,0"/>
                            <Button Content="Export 'Reviewed' Viewpoints" Command="{Binding ExportViewpointsCommand}" Style="{StaticResource ActionButton}" Margin="0,0,6,0"/>
                            <Button Content="Re-Run Selected" Command="{Binding ReRunSelectedCommand}" Style="{StaticResource PrimaryButton}" Padding="14,6"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
