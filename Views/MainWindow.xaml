<Window x:Class="AutomatedClashRunner.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Automated Clash Runner &amp; Distiller" 
        Height="760" Width="1160" 
        MinHeight="600" MinWidth="950"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" 
        FontSize="12"
        Background="#F8FAFC">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Search Box Style -->
        <Style x:Key="ModernSearchBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="2" />
                            </Border>
                            <TextBlock Text="{TemplateBinding Tag}"
                                       Foreground="#94A3B8"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="BorderBrush" Value="#94A3B8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Green Button Style -->
        <Style x:Key="PrimaryGreenButton" TargetType="Button">
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Background" Value="#00875A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#00704A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00A36C"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#94A3B8"/>
                    <Setter Property="Opacity" Value="0.6"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Blue Accent Button Style for Tools Test -->
        <Style x:Key="PrimaryBlueButton" TargetType="Button">
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0369A1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0EA5E9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#94A3B8"/>
                    <Setter Property="Opacity" Value="0.6"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Orange Accent Button Style for Base Build -->
        <Style x:Key="PrimaryOrangeButton" TargetType="Button">
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Background" Value="#D97706"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#B45309"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F59E0B"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#94A3B8"/>
                    <Setter Property="Opacity" Value="0.6"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Mini Selection Button -->
        <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>

        <!-- Status Filter Toggle Button -->
        <Style x:Key="StatusToggleButton" TargetType="ToggleButton">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#0284C7"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#0369A1"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#0284C7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Clean GridView Header Style -->
        <Style x:Key="CleanGridViewHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Modern Multi-Select ListViewItem Style binding row selection to IsSelected -->
        <Style x:Key="MultiSelectListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F0F9FF"/>
                    <Setter Property="BorderBrush" Value="#BAE6FD"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#E0F2FE"/>
                    <Setter Property="BorderBrush" Value="#7DD3FC"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <!-- Modern TabItem Style with Header ContentSource -->
        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,3"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,16,0"
                                Cursor="Hand">
                            <ContentPresenter ContentSource="Header" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center" 
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#00875A"/>
                                <Setter Property="Foreground" Value="#00875A"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP APP HEADER BAR -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="18,12,18,12">
            <DockPanel>
                <Border Width="36" Height="36" Background="#00875A" CornerRadius="6" Margin="0,0,12,0" DockPanel.Dock="Left">
                    <TextBlock Text="ACR" FontWeight="Bold" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Automated Clash Runner &amp; Distiller" FontWeight="Bold" FontSize="16" Foreground="#0F172A"/>
                    <TextBlock Text="Autodesk Navisworks Automated Coordination Suite" FontSize="11" Foreground="#64748B"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN TABS CONTAINER -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0" Margin="14,10,14,14">
            
            <!-- ========================================================================= -->
            <!-- TAB 1: GENERATE MATRIX                                                    -->
            <!-- ========================================================================= -->
            <TabItem Header="Generate Matrix" Style="{StaticResource ModernTabItem}" DataContext="{Binding MatrixTab}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Models / NWCs -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="0,0,6,8" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Selected Models / NWCs" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ModelSelectionSummary}" HorizontalAlignment="Right" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                            </DockPanel>

                            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="4,0,0,0">
                                    <Button Content="All" Command="{Binding SelectAllModelsCommand}" Style="{StaticResource MiniButton}"/>
                                    <Button Content="None" Command="{Binding DeselectAllModelsCommand}" Style="{StaticResource MiniButton}"/>
                                </StackPanel>
                                <TextBox Style="{StaticResource ModernSearchBox}" 
                                         Tag="Filter models by name..." 
                                         Text="{Binding SearchTextModels, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>

                            <ListView x:Name="ListViewModels" Grid.Row="2" ItemsSource="{Binding ModelsView}" 
                                      SelectionMode="Extended"
                                      ItemContainerStyle="{StaticResource MultiSelectListViewItemStyle}"
                                      BorderBrush="#E2E8F0" Background="#FFFFFF">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsSelectable}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border Background="#F1F5F9" CornerRadius="3" Padding="5,1" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding DisplayType}" FontSize="10" Foreground="#475569" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" Foreground="#0F172A" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding WarningMessage}" Foreground="#DC2626" Margin="8,0,0,0" FontStyle="Italic" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock Grid.Row="2" Text="No NWC models found in document." 
                                       Foreground="#94A3B8" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasNoModels, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>

                    <!-- Right: Search Sets -->
                    <Border Grid.Row="0" Grid.Column="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="6,0,0,8" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Manual Search Sets" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SetSelectionSummary}" HorizontalAlignment="Right" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                            </DockPanel>

                            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="4,0,0,0">
                                    <Button Content="All" Command="{Binding SelectAllSetsCommand}" Style="{StaticResource MiniButton}"/>
                                    <Button Content="None" Command="{Binding DeselectAllSetsCommand}" Style="{StaticResource MiniButton}"/>
                                </StackPanel>
                                <TextBox Style="{StaticResource ModernSearchBox}" 
                                         Tag="Filter search sets by path..." 
                                         Text="{Binding SearchTextSets, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>

                            <ListView x:Name="ListViewSearchSets" Grid.Row="2" ItemsSource="{Binding SearchSetsView}" 
                                      SelectionMode="Extended"
                                      ItemContainerStyle="{StaticResource MultiSelectListViewItemStyle}"
                                      BorderBrush="#E2E8F0" Background="#FFFFFF">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="True" VerticalAlignment="Center" Margin="0,0,8,0"
                                                      Visibility="{Binding IsSet, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding FullPath}" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock Grid.Row="2" Text="No manual search sets found in document." 
                                       Foreground="#94A3B8" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasNoSets, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>

                    <!-- Bottom Configuration Card -->
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="Clash Test Type: " VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                            <ComboBox ItemsSource="{Binding AvailableClashTypes}" SelectedItem="{Binding SelectedClashType}" Width="130" Margin="0,0,20,0" Padding="6,3"/>
                            
                            <TextBlock Text="Tolerance (m): " VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBox Text="{Binding Tolerance, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,20,0" Padding="6,3" VerticalContentAlignment="Center"/>

                            <TextBlock Text="Selection B Mode: " VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBlock Text="Standard Model Hierarchy | " VerticalAlignment="Center" Foreground="#00875A" FontWeight="SemiBold" Margin="0,0,8,0"/>

                            <TextBlock Text="Composite Clashing: " VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBlock Text="Enabled" VerticalAlignment="Center" Foreground="#64748B"/>
                        </WrapPanel>
                    </Border>

                    <!-- Footer Action Bar -->
                    <DockPanel Grid.Row="2" Grid.ColumnSpan="2">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Command="{Binding RefreshModelsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                          Fill="#475569" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Refresh Models" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RefreshSearchSetsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                          Fill="#475569" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Refresh Sets" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ClearAllCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                          Fill="#64748B" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Clear All" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding GenerateSelectionSetsCommand}" Style="{StaticResource SecondaryButton}"
                                    ToolTip="Auto-create Selection Sets for each selected NWC containing all sibling NWCs under the same parent NWD (excluding the NWC itself). Sets are placed in the 'Tests' folder.">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M11.99 18.54l-7.37-5.73L3 14.07l9 7 9-7-1.63-1.27-7.38 5.74zM12 16l7.36-5.73L21 9.07l-9-7-9 7 1.63 1.27L12 16zm0-11.47L17.74 9 12 13.47 6.26 9 12 4.53z"
                                          Fill="#0284C7" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Generate Sets" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                            <Button Command="{Binding BaseBuildTestCommand}" Style="{StaticResource PrimaryOrangeButton}" Margin="0,0,10,0"
                                    ToolTip="Runs clash tests for each selected NWC against the 'Base Build' Selection Set (no T- prefix).">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12 3L2 12h3v8h6v-6h2v6h6v-8h3L12 3z"
                                          Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedModelCount, StringFormat='Base Build ({0} NWCs)'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ToolsTestCommand}" Style="{StaticResource PrimaryBlueButton}" Margin="0,0,10,0"
                                    ToolTip="Automatically pairs each selected NWC model with its corresponding Selection Set (T- prefix) and runs 1-to-1 clash tests.">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"
                                          Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedModelCount, StringFormat='Tools test ({0} NWCs)'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RunCommand}" Style="{StaticResource PrimaryGreenButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M8 5v14l11-7z"
                                          Fill="White" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ExpectedTestCount, StringFormat='Run Clash Matrix ({0} Tests)'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- Loading Overlay -->
                    <Grid Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#90FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <Border Background="#FFFFFF" BorderBrush="#00875A" BorderThickness="2" CornerRadius="8" 
                                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" Width="440">
                            <StackPanel>
                                <TextBlock Text="Executing Clash Matrix..." FontWeight="Bold" FontSize="15" Foreground="#00875A" Margin="0,0,0,12" HorizontalAlignment="Center"/>
                                <ProgressBar Value="{Binding ProgressBarValue}" Maximum="{Binding ProgressBarMax}" Height="18" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding ProgressText}" Foreground="#475569" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>


            <!-- ========================================================================= -->
            <!-- TAB 2: DISTILL (MATCHING REFERENCE IMAGE 2)                               -->
            <!-- ========================================================================= -->
            <TabItem Header="Distill Clashes" Style="{StaticResource ModernTabItem}" DataContext="{Binding DistillerTab}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title Header Banner -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="DISTILL" FontWeight="Bold" FontSize="24" Foreground="#0F172A" VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Select All" Command="{Binding SelectAllTestsCommand}" Style="{StaticResource MiniButton}" Margin="0,0,4,0"/>
                            <Button Content="Deselect All" Command="{Binding DeselectAllTestsCommand}" Style="{StaticResource MiniButton}" Margin="0,0,8,0"/>
                            <TextBox Style="{StaticResource ModernSearchBox}" 
                                     Tag="Filter tests..." 
                                     Width="220"
                                     Text="{Binding SearchTextTests, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Main Data Table with Column Counts -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10">
                        <ListView x:Name="ListViewDistillerTests" ItemsSource="{Binding TestsView}" 
                                  SelectionMode="Extended"
                                  ItemContainerStyle="{StaticResource MultiSelectListViewItemStyle}"
                                  BorderThickness="0" Background="Transparent">
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource CleanGridViewHeader}">
                                    <GridViewColumn Width="40">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Clash Test" Width="430">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#0F172A"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Active/New" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ActiveNewCount}" Foreground="#D97706" FontWeight="SemiBold" TextAlignment="Right"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Reviewed" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ReviewedCount}" Foreground="#0284C7" FontWeight="SemiBold" TextAlignment="Right"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Approved" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ApprovedCount}" Foreground="#00875A" FontWeight="SemiBold" TextAlignment="Right"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Resolved" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ResolvedCount}" Foreground="#64748B" TextAlignment="Right"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Total" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TotalCount}" FontWeight="Bold" Foreground="#0F172A" TextAlignment="Right"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>

                    <!-- Distillation Settings Card -->
                    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="420"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Distillation Settings" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,8"/>
                                
                                <TextBlock Text="Proximity Clustering Range:" FontWeight="SemiBold" Foreground="#475569" FontSize="11" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="Focused" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                    <TextBlock Text="Global" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                                    <TextBox Text="{Binding GroupingProximity, UpdateSourceTrigger=PropertyChanged}" Width="40" DockPanel.Dock="Right" Padding="2" TextAlignment="Center" VerticalContentAlignment="Center" Margin="6,0,0,0"/>
                                    <Slider Minimum="1" Maximum="150" Value="{Binding GroupingProximity}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBlock Text="Clustering Strategy:" FontWeight="SemiBold" Foreground="#475569" FontSize="11" Margin="0,0,0,4"/>
                                <TextBlock Text="- Group by Master Named Element in Selection A" Foreground="#0F172A" FontSize="11" Margin="4,0,0,2"/>
                                <TextBlock Text="- Sub-cluster by spatial proximity threshold" Foreground="#0F172A" FontSize="11" Margin="4,0,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Clash Classification &amp; Grouping" FontWeight="Bold" FontSize="12" Foreground="#0F172A" Margin="0,0,0,8"/>
                                    <TextBlock Text="Group naming format: {TestName}-{001, 002, ...}" FontSize="11" Foreground="#475569" Margin="0,0,0,6"/>
                                    <TextBlock Text="Raw clashes within proximity distance are organized cleanly into named groups under each clash test in Clash Detective." FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <DockPanel Grid.Row="3">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Command="{Binding RefreshTestsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                          Fill="#475569" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Refresh Tests" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ReRunSelectedCommand}" Style="{StaticResource SecondaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M8 5v14l11-7z"
                                          Fill="#0284C7" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Re-Run Selected" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding DistillSelectedCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z"
                                          Fill="#475569" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Distill Selected Test(s)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding DistillAllCommand}" Style="{StaticResource PrimaryGreenButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z"
                                          Fill="White" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Distill All Tests" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>


            <!-- ========================================================================= -->
            <!-- TAB 3: VIEWPOINTS (MATCHING REFERENCE IMAGE 1)                           -->
            <!-- ========================================================================= -->
            <TabItem Header="Create Viewpoints" Style="{StaticResource ModernTabItem}" DataContext="{Binding ViewpointsTab}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="VIEWPOINTS" FontWeight="Bold" FontSize="24" Foreground="#0F172A" VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Select All" Command="{Binding SelectAllTestsCommand}" Style="{StaticResource MiniButton}" Margin="0,0,4,0"/>
                            <Button Content="Deselect All" Command="{Binding DeselectAllTestsCommand}" Style="{StaticResource MiniButton}" Margin="0,0,8,0"/>
                            <TextBox Style="{StaticResource ModernSearchBox}" 
                                     Tag="Filter tests..." 
                                     Width="220"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10">
                        <ListView x:Name="ListViewViewpointsTests" ItemsSource="{Binding TestsView}" 
                                  SelectionMode="Extended"
                                  ItemContainerStyle="{StaticResource MultiSelectListViewItemStyle}"
                                  BorderThickness="0" Background="Transparent">
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource CleanGridViewHeader}">
                                    <GridViewColumn Width="40">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Clash Test" Width="440">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Active/New" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ActiveNewCount}" Foreground="#D97706" FontWeight="SemiBold" TextAlignment="Right"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Reviewed" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ReviewedCount}" Foreground="#0284C7" FontWeight="SemiBold" TextAlignment="Right"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Approved" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ApprovedCount}" Foreground="#00875A" FontWeight="SemiBold" TextAlignment="Right"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Resolved" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ResolvedCount}" Foreground="#64748B" TextAlignment="Right"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Total" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TotalCount}" FontWeight="Bold" Foreground="#0F172A" TextAlignment="Right"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>

                    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Viewpoint Settings" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,8"/>

                            <WrapPanel Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" Margin="0,0,24,6">
                                    <TextBlock Text="Group by: " FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="8,4">
                                        <TextBlock Text="Dedicated Test Folder" FontWeight="Medium" Foreground="#0F172A"/>
                                    </Border>
                                </StackPanel>

                                <CheckBox Content="Place viewpoints in timestamped master folder" IsChecked="{Binding PlaceInTimestampedFolder}" VerticalAlignment="Center" Margin="0,0,20,6"/>
                            </WrapPanel>

                            <DockPanel>
                                <TextBlock Text="Include statuses: " FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton Content="New" IsChecked="{Binding IncludeNew}" Style="{StaticResource StatusToggleButton}" Margin="0,0,4,0"/>
                                    <ToggleButton Content="Active" IsChecked="{Binding IncludeActive}" Style="{StaticResource StatusToggleButton}" Margin="0,0,4,0"/>
                                    <ToggleButton Content="Reviewed" IsChecked="{Binding IncludeReviewed}" Style="{StaticResource StatusToggleButton}" Margin="0,0,4,0"/>
                                    <ToggleButton Content="Approved" IsChecked="{Binding IncludeApproved}" Style="{StaticResource StatusToggleButton}" Margin="0,0,4,0"/>
                                    <ToggleButton Content="Resolved" IsChecked="{Binding IncludeResolved}" Style="{StaticResource StatusToggleButton}"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <DockPanel Grid.Row="3">
                        <Button Command="{Binding RefreshTestsCommand}" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Left">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                      Fill="#475569" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Refresh Tests" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding CreateViewpointsSelectedCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12 12m-3.2 0a3.2 3.2 0 1 0 6.4 0 3.2 3.2 0 1 0-6.4 0M9 2L7.17 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2h-3.17L15 2H9zm3 15c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z"
                                          Fill="#475569" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Create Viewpoints for Selected Test(s)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CreateViewpointsAllCommand}" Style="{StaticResource PrimaryGreenButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12 12m-3.2 0a3.2 3.2 0 1 0 6.4 0 3.2 3.2 0 1 0-6.4 0M9 2L7.17 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2h-3.17L15 2H9zm3 15c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z"
                                          Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Create Viewpoints for All Tests" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>