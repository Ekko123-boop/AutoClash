<Window x:Class="AutomatedClashRunner.Views.SummaryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Execution Summary" Height="450" Width="650"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12">
    
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding SummaryHeaderText}" FontWeight="Bold" FontSize="14" Foreground="#263238" Margin="0,0,0,8"/>

        <Border Grid.Row="1" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="3" Background="#FAFAFA">
            <ListView ItemsSource="{Binding Items}" BorderThickness="0" Background="Transparent">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="{Binding Icon}" FontWeight="Bold" Foreground="{Binding ColorHex}" Width="20" TextAlignment="Center"/>
                            <Border Background="#ECEFF1" CornerRadius="2" Padding="4,1" Margin="4,0,8,0">
                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#546E7A"/>
                            </Border>
                            <TextBlock Text="{Binding Message}" Foreground="#37474F" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Copy to Clipboard" Command="{Binding CopyCommand}" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="Export to CSV..." Command="{Binding ExportCsvCommand}" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="Close" Command="{Binding CloseCommand}" Padding="16,6" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
