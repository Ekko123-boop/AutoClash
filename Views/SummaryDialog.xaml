<Window x:Class="AutomatedClashRunner.Views.SummaryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Execution Summary" 
        Height="480" Width="680"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" 
        FontSize="12"
        Background="#F8FAFC">
    
    <Window.Resources>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryGreenButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="#00875A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#00704A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00A36C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Border Width="30" Height="30" Background="#E0F2FE" CornerRadius="6" Margin="0,0,10,0" DockPanel.Dock="Left">
                <TextBlock Text="ðŸ“Š" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding SummaryHeaderText}" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
                <TextBlock Text="Clash matrix run completed" FontSize="11" Foreground="#64748B"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="6">
            <ListView ItemsSource="{Binding Items}" BorderThickness="0" Background="Transparent">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="{Binding Icon}" FontWeight="Bold" Foreground="{Binding ColorHex}" Width="24" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Border Background="#F1F5F9" CornerRadius="3" Padding="6,2" Margin="4,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#475569" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="{Binding Message}" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Copy to Clipboard" Command="{Binding CopyCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
            <Button Content="Export to CSV..." Command="{Binding ExportCsvCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
            <Button Content="Close" Command="{Binding CloseCommand}" Style="{StaticResource PrimaryGreenButton}" Padding="20,7"/>
        </StackPanel>
    </Grid>
</Window>
