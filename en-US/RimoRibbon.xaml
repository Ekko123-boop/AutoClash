<?xml version="1.0" encoding="utf-8" ?>
<!-- BEGIN STANDARD SECTION DO NOT EDIT -->
<RibbonControl
    x:Uid="RimoTools" xmlns="clr-namespace:Autodesk.Windows;assembly=AdWindows"
    xmlns:wpf="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:adwi="clr-namespace:Autodesk.Internal.Windows;assembly=AdWindows"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Autodesk.Navisworks.Gui.Roamer.AIRLook;assembly=navisworks.gui.roamer">
    <!-- END STANDARD SECTION DO NOT EDIT -->
    
    <RibbonTab Id="Rimo" KeyTip="R1" Title="Rimo">
        <RibbonPanel x:Uid="RibbonPanel_Rimo_1">
            <RibbonPanelSource x:Uid="RibbonPanelSource_Rimo_1" KeyTip="C1" Title="Clash Tools">

                <local:NWRibbonButton x:Uid="CmdMatrix" Id="ID_RIMO_CMD_MATRIX"
                            Size="Large"
                            KeyTip="B1"
                            ShowText="True"
                            Text="Clash Matrix"
                            Orientation="Vertical"
                />

                <local:NWRibbonButton x:Uid="CmdDistill" Id="ID_RIMO_CMD_DISTILL"
                            Size="Large"
                            KeyTip="B2"
                            ShowText="True"
                            Text="Distill Clashes"
                            Orientation="Vertical"
                />

                <local:NWRibbonButton x:Uid="CmdViewpoints" Id="ID_RIMO_CMD_VIEWPOINTS"
                            Size="Large"
                            KeyTip="B3"
                            ShowText="True"
                            Text="Create Viewpoints"
                            Orientation="Vertical"
                />

            </RibbonPanelSource>
        </RibbonPanel>
    </RibbonTab>

</RibbonControl>
